# ============================================================================
# Projeto: HappyHouse Link Shortener
# Arquivo: .gitattributes
# Autor: Fabio Castilhos <fabcastilhos@gmail.com>
# Organizacao: HappyHouse
# ============================================================================

# Padronizacao dos finais de linha
* text=auto

# ApacheConf: linguagem principal do projeto
go/.htaccess text eol=lf linguist-language=ApacheConf linguist-detectable

# Python: testes automatizados, fora das estatisticas
tests/** linguist-vendored
*.py linguist-vendored

# Documentacao
*.md text eol=lf linguist-documentation
docs/** linguist-documentation
