# Padronizacao dos finais de linha
* text=auto

# Configuracoes Apache
*.htaccess text eol=lf linguist-language=ApacheConf
.htaccess text eol=lf linguist-language=ApacheConf

# Arquivos Python utilizados exclusivamente para testes
tests/*.py text eol=lf linguist-detectable=false

# Documentacao
*.md text eol=lf
