# ============================================================================
# Projeto: HappyHouse Link Shortener
# Arquivo: .gitattributes
# Autor: Fabio Castilhos <fabcastilhos@gmail.com>
# Organizacao: HappyHouse
# ============================================================================

# Padronizacao dos finais de linha
* text=auto

# Linguagem principal: ApacheConf
go/.htaccess linguist-language=ApacheConf
**/.htaccess linguist-language=ApacheConf

# Excluir arquivos Python das estatisticas de linguagem
tests/** linguist-vendored
*.py linguist-vendored

# Excluir documentacao das estatisticas
docs/** linguist-documentation
*.md linguist-documentation
